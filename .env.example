# ============================================
# OMNI CARTIX — Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# Database (Supabase PostgreSQL)
# Pooled connection for app (PgBouncer port 6543)
DATABASE_URL="postgresql://postgres.[project]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection for migrations (port 5432)
DIRECT_URL="postgresql://postgres.[project]:[password]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""  # Generate: openssl rand -base64 32

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# PayPal (https://developer.paypal.com)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_WEBHOOK_ID=""

# Cloudflare R2 (or AWS S3)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="omni-cartix-assets"
NEXT_PUBLIC_R2_PUBLIC_URL="https://assets.omnicartix.co.uk"

# Resend Email (https://resend.com)
RESEND_API_KEY="re_..."
EMAIL_FROM="Omni Cartix <orders@omnicartix.co.uk>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_EMAIL="admin@omnicartix.co.uk"
